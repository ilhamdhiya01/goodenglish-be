generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma7.config.ts (Prisma 7 no longer reads it
// from here).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEARNER
}

// One value per top-level tab in the app. ADMIN tokens ignore these and get
// everything.
enum Menu {
  PLAN
  VOCAB
  REVIEW
  SCENARIO
  ERRORS
  GRAMMAR
  PRONUNCIATION
  CHEATSHEET
  // Not a tab: the floating "Tanya AI" chat. Listed here so admins can grant
  // it per token like any other menu.
  AI
  // Not a tab either: "Main peran" (voice roleplay with the AI) inside
  // Skenario. Needs SCENARIO too.
  ROLEPLAY
  // "Menyimak": listening practice (dictation, listen & answer, minimal pairs).
  LISTENING
  // "Bacaan": graded reading texts with tap-a-word and questions.
  READING
}

enum Level {
  BEGINNER
  PRE
  INTER
  UPPER
}

// 1:1 with the localStorage keys the app used before it had a backend (see
// goodenglish-fe const/storage-keys.constant.ts). Each document stores the
// exact JSON that key held, so the client-side stores keep working unchanged
// and old exported progress files stay compatible.
enum ProgressKey {
  KNOWN
  SRS
  OWN
  CUSTOM
  DONE
  LEVEL
  WEEKS
  ASKPRAC
  PLAN
  PRACTICE_SESSION
  FLIP
  SEARCH_SCOPE
  // Added with "Main peran": the learner's roleplay history (transcripts and
  // end-of-session summaries) and the mistakes collected from them.
  ROLEPLAY
  MISTAKES
  // Added with "Menyimak": set results, unlocked stages, seen items, pair stats.
  LISTENING
  // Added with "Bacaan": texts read, quiz results, saved-word counts.
  READING
  // Added with the placement test and end-of-level exams.
  EXAM
}

// An access token IS the learner's identity: there are no user accounts.
// The plaintext token is shown once at creation and never stored — only its
// SHA-256 hash (enough here because tokens carry 256 bits of randomness, so
// there's nothing to brute-force that a slow hash would protect).
model AccessToken {
  id                 String    @id @default(cuid())
  label              String    @db.VarChar(100)
  tokenHash          String    @unique @db.Char(64)
  // First characters of the plaintext (e.g. "ge_k3F9x"), so admins can tell
  // tokens apart without the secret.
  tokenPrefix        String    @db.VarChar(16)
  role               Role      @default(LEARNER)
  menus              Menu[]
  levels             Level[]
  maxDevices         Int       @default(2)
  // "Tanya AI" questions per day. null = unlimited.
  aiDailyLimit       Int?      @default(30)
  // "Main peran" sessions per day. null = unlimited.
  roleplayDailyLimit Int?      @default(3)
  // The next level opens only after passing the end-of-level exam of the
  // level before it (enforced by the app, like all progress).
  requireExam        Boolean   @default(false)
  expiresAt          DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions         TokenSession[]
  progress         ProgressDoc[]
  aiUsage          AiUsage[]
  aiConversations  AiConversation[]
  roleplaySessions RoleplaySession[]

  @@map("access_tokens")
}

// Questions asked to the AI per token per day (Asia/Jakarta calendar day),
// for the daily quota. The conversations themselves are in AiConversation.
model AiUsage {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  day           DateTime    @db.Date
  count         Int         @default(0)

  @@unique([accessTokenId, day])
  @@map("ai_usage")
}

// Gemini's own role names, upper-cased like the other enums.
enum AiRole {
  USER
  MODEL
}

// A "Tanya AI" thread. Belongs to the token, so every device that redeemed it
// sees the same history. "Percakapan baru" starts a new one; old threads stay
// until the learner deletes them (or the token is deleted).
model AiConversation {
  id            String          @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken     @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  // The first question, cut to fit.
  title         String          @db.VarChar(120)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      AiChatMessage[]

  @@index([accessTokenId, updatedAt])
  @@map("ai_conversations")
}

// Written by POST /ai/chat itself: the question once Gemini accepts it, the
// answer once it has streamed. Failed replies are never stored.
model AiChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  text           String         @db.Text
  // The word card the question came from (context.word / context.meaning),
  // shown as a chip.
  word           String?        @db.VarChar(120)
  wordMeaning    String?        @db.VarChar(300)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_chat_messages")
}

// One row per device that redeemed the token. Active = not revoked and not
// past expiresAt; the active count is what maxDevices limits.
model TokenSession {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  deviceLabel   String      @db.VarChar(120)
  expiresAt     DateTime
  lastSeenAt    DateTime    @default(now())
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([accessTokenId])
  @@map("token_sessions")
}

model ProgressDoc {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  key           ProgressKey
  data          Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accessTokenId, key])
  @@map("progress_docs")
}

// Vocabulary added by an admin on top of the words bundled in the frontend.
// Unlike a learner's own "Kataku" (the CUSTOM progress doc), these are shared:
// every token that may open `level` sees them in that week.
model SharedWord {
  id        String   @id @default(cuid())
  level     Level
  week      Int
  // Word type id from the frontend (w, pv, col, st, ex, cj).
  type      String   @db.VarChar(8)
  en        String   @db.VarChar(120)
  meaning   String   @db.VarChar(300)
  pron      String   @default("") @db.VarChar(120)
  example   String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, week])
  @@map("shared_words")
}

// One row (id = 1): the Gemini API key and model behind "Tanya AI", set from
// the admin dashboard instead of .env. The key is stored AES-256-GCM
// encrypted with ENCRYPTION_KEY; only its last 4 characters are ever shown.
model AiSettings {
  id           Int      @id @default(1)
  encryptedKey String?
  keyLast4     String?  @db.VarChar(4)
  model        String   @default("gemini-3.6-flash") @db.VarChar(100)
  // Label of the admin token that saved last.
  updatedBy    String?  @db.VarChar(100)
  updatedAt    DateTime @updatedAt

  @@map("ai_settings")
}

// One "Main peran" session (voice roleplay inside Skenario). The server keeps
// only what it must enforce or report: the daily quota (rows per `day`), the
// turn and help caps, and the minutes shown in the admin summary. Transcripts
// and summaries live in the learner's ROLEPLAY progress doc.
model RoleplaySession {
  id              String      @id @default(cuid())
  accessTokenId   String
  accessToken     AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  // Asia/Jakarta calendar day the session started on (quota bucket).
  day             DateTime    @db.Date
  scenarioId      String      @db.VarChar(40)
  // Roles, mission, steps, key phrases and level sent at start; reused for
  // every turn so the client can't change the mission mid-session.
  context         Json
  stepsDone       Int[]       @default([])
  userTurns       Int         @default(0)
  helpCount       Int         @default(0)
  // Spoken answers written down by Gemini ("Main peran" mic).
  transcribeCount Int         @default(0)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSec     Int?
  missionComplete Boolean?

  @@index([accessTokenId, day])
  @@index([accessTokenId, startedAt])
  @@map("roleplay_sessions")
}

enum ListeningStatus {
  DRAFT
  PUBLISHED
}

enum ListeningType {
  DIALOG
  MONOLOG
}

// "Menyimak › Dengar & jawab": a 40–120 word dialogue or announcement with
// 3 multiple-choice questions. Generated once with Gemini by an admin
// (Admin › Kelola › Menyimak), checked and edited as a DRAFT, then
// PUBLISHED. Learners only ever read published items, so nothing is
// generated again per learner.
model ListeningItem {
  id          String          @id @default(cuid())
  level       Level
  week        Int
  status      ListeningStatus @default(DRAFT)
  type        ListeningType
  title       String          @db.VarChar(160)
  // [{ speaker: "A" | "B", text }]
  lines       Json
  // [{ question, options: string[4], answerIndex, explanationId }]
  questions   Json
  wordCount   Int
  // Label of the admin token that generated or last saved it.
  createdBy   String?         @db.VarChar(100)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([level, week, status])
  @@map("listening_items")
}

enum ReadingStatus {
  DRAFT
  PUBLISHED
}

enum ReadingSlot {
  // 150–200 words
  A
  // 200–300 words
  B
}

// "Bacaan": a graded reading text per level, week and slot, generated once
// with Gemini by an admin (Admin › Kelola › Bacaan), checked and edited as a
// DRAFT, then PUBLISHED for every learner. Drafts that miss a content rule
// (length, target words) are kept with `warnings` for the admin to fix.
model ReadingText {
  id              String        @id @default(cuid())
  level           Level
  week            Int
  slot            ReadingSlot
  status          ReadingStatus @default(DRAFT)
  title           String        @db.VarChar(160)
  // [{ en, id }] — id is the Indonesian translation of the paragraph
  paragraphs      Json
  // Words of the week's Kosakata the text uses (as Gemini reported them)
  targetWordsUsed Json
  // [{ word, meaningId }] — harder words outside Kosakata
  glossary        Json
  // 5 questions: 3 mcq, 1 true_false, 1 find_word
  questions       Json
  wordCount       Int
  // Content rules the text misses ("word_count", "few_target_words", …)
  warnings        Json          @default("[]")
  createdBy       String?       @db.VarChar(100)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([level, week, status])
  @@map("reading_texts")
}

// Meaning of a word that is neither in Kosakata nor in a text's glossary,
// asked to Gemini once and shared by every learner (Bacaan's tap-a-word).
model WordMeaning {
  id        String   @id @default(cuid())
  // Lower-cased word as tapped
  word      String   @db.VarChar(60)
  level     Level
  lemma     String   @db.VarChar(60)
  meaningId String   @db.VarChar(200)
  pron      String   @default("") @db.VarChar(80)
  createdAt DateTime @default(now())

  @@unique([word, level])
  @@map("word_meanings")
}
