generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma7.config.ts (Prisma 7 no longer reads it
// from here).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEARNER
}

// One value per top-level tab in the app. ADMIN tokens ignore these and get
// everything.
enum Menu {
  PLAN
  VOCAB
  REVIEW
  SCENARIO
  ERRORS
  GRAMMAR
  PRONUNCIATION
  CHEATSHEET
  // Not a tab: the floating "Tanya AI" chat. Listed here so admins can grant
  // it per token like any other menu.
  AI
}

enum Level {
  BEGINNER
  PRE
  INTER
  UPPER
}

// 1:1 with the localStorage keys the app used before it had a backend (see
// goodenglish-fe const/storage-keys.constant.ts). Each document stores the
// exact JSON that key held, so the client-side stores keep working unchanged
// and old exported progress files stay compatible.
enum ProgressKey {
  KNOWN
  SRS
  OWN
  CUSTOM
  DONE
  LEVEL
  WEEKS
  ASKPRAC
  PLAN
  PRACTICE_SESSION
  FLIP
  SEARCH_SCOPE
}

// An access token IS the learner's identity: there are no user accounts.
// The plaintext token is shown once at creation and never stored — only its
// SHA-256 hash (enough here because tokens carry 256 bits of randomness, so
// there's nothing to brute-force that a slow hash would protect).
model AccessToken {
  id           String    @id @default(cuid())
  label        String    @db.VarChar(100)
  tokenHash    String    @unique @db.Char(64)
  // First characters of the plaintext (e.g. "ge_k3F9x"), so admins can tell
  // tokens apart without the secret.
  tokenPrefix  String    @db.VarChar(16)
  role         Role      @default(LEARNER)
  menus        Menu[]
  levels       Level[]
  maxDevices   Int       @default(2)
  // "Tanya AI" questions per day. null = unlimited.
  aiDailyLimit Int?      @default(30)
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        TokenSession[]
  progress        ProgressDoc[]
  aiUsage         AiUsage[]
  aiConversations AiConversation[]

  @@map("access_tokens")
}

// Questions asked to the AI per token per day (Asia/Jakarta calendar day),
// for the daily quota. The conversations themselves are in AiConversation.
model AiUsage {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  day           DateTime    @db.Date
  count         Int         @default(0)

  @@unique([accessTokenId, day])
  @@map("ai_usage")
}

// Gemini's own role names, upper-cased like the other enums.
enum AiRole {
  USER
  MODEL
}

// A "Tanya AI" thread. Belongs to the token, so every device that redeemed it
// sees the same history. "Percakapan baru" starts a new one; old threads stay
// until the learner deletes them (or the token is deleted).
model AiConversation {
  id            String          @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken     @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  // The first question, cut to fit.
  title         String          @db.VarChar(120)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      AiChatMessage[]

  @@index([accessTokenId, updatedAt])
  @@map("ai_conversations")
}

// Written by POST /ai/chat itself: the question once Gemini accepts it, the
// answer once it has streamed. Failed replies are never stored.
model AiChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  text           String         @db.Text
  // The word card the question came from (context.word / context.meaning),
  // shown as a chip.
  word           String?        @db.VarChar(120)
  wordMeaning    String?        @db.VarChar(300)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_chat_messages")
}

// One row per device that redeemed the token. Active = not revoked and not
// past expiresAt; the active count is what maxDevices limits.
model TokenSession {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  deviceLabel   String      @db.VarChar(120)
  expiresAt     DateTime
  lastSeenAt    DateTime    @default(now())
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([accessTokenId])
  @@map("token_sessions")
}

model ProgressDoc {
  id            String      @id @default(cuid())
  accessTokenId String
  accessToken   AccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  key           ProgressKey
  data          Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accessTokenId, key])
  @@map("progress_docs")
}

// Vocabulary added by an admin on top of the words bundled in the frontend.
// Unlike a learner's own "Kataku" (the CUSTOM progress doc), these are shared:
// every token that may open `level` sees them in that week.
model SharedWord {
  id        String   @id @default(cuid())
  level     Level
  week      Int
  // Word type id from the frontend (w, pv, col, st, ex, cj).
  type      String   @db.VarChar(8)
  en        String   @db.VarChar(120)
  meaning   String   @db.VarChar(300)
  pron      String   @default("") @db.VarChar(120)
  example   String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, week])
  @@map("shared_words")
}

// One row (id = 1): the Gemini API key and model behind "Tanya AI", set from
// the admin dashboard instead of .env. The key is stored AES-256-GCM
// encrypted with ENCRYPTION_KEY; only its last 4 characters are ever shown.
model AiSettings {
  id           Int      @id @default(1)
  encryptedKey String?
  keyLast4     String?  @db.VarChar(4)
  model        String   @default("gemini-3.6-flash") @db.VarChar(100)
  // Label of the admin token that saved last.
  updatedBy    String?  @db.VarChar(100)
  updatedAt    DateTime @updatedAt

  @@map("ai_settings")
}
