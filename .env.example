# Copy to .env (VPS: ~/goodenglish/goodenglish-be/.env). Source of truth for
# what's required: src/config/validation.schema.ts.
NODE_ENV=production
LOG_LEVEL=warn
PORT=3001

# Compose-only
GHCR_OWNER=ilhamdhiya01
IMAGE_TAG=latest
POSTGRES_PASSWORD=change-me

# Inside Compose the host is the `db` service, not localhost.
DATABASE_URL=postgresql://postgres:change-me@db:5432/goodenglish_db

# openssl rand -hex 32
JWT_SECRET=
SESSION_DAYS=30
COOKIE_SECURE=true
FE_URL=https://goodenglish.my.id

# "Tanya AI": the Gemini API key and model are set from Admin › Tanya AI and
# stored encrypted in the DB with this key (openssl rand -hex 32). Without it
# the app still runs, but no Gemini key can be saved.
ENCRYPTION_KEY=
# Default questions per day for NEW tokens (each token can then be changed,
# or made unlimited, from the admin token form). Resets at midnight WIB.
AI_DAILY_LIMIT=30

# Speech-to-text for the Main peran mic: the `stt` service in
# docker-compose.yml (faster-whisper, self-hosted). Inside Compose `app`
# reaches it at http://stt:8000 (the default); for `pnpm start:dev` use the
# port published by docker-compose.override.yml: http://127.0.0.1:8100
# STT_URL=http://stt:8000
# Recordings per token per minute, and how long to wait for one (ms).
STT_RATE_PER_MIN=12
STT_TIMEOUT_MS=45000
# Read by the `stt` container (see stt/README.md). Defaults suit a
# 2 vCPU / 4 GB CPU-only VPS.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=2
STT_BEAM_SIZE=5
STT_CONCURRENCY=1
STT_QUEUE_MAX=4
