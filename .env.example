# Copy to .env (VPS: ~/goodenglish/goodenglish-be/.env). Source of truth for
# what's required: src/config/validation.schema.ts.
NODE_ENV=production
LOG_LEVEL=warn
PORT=3001

# Compose-only
GHCR_OWNER=ilhamdhiya01
IMAGE_TAG=latest
POSTGRES_PASSWORD=change-me

# Inside Compose the host is the `db` service, not localhost.
DATABASE_URL=postgresql://postgres:change-me@db:5432/goodenglish_db

# openssl rand -hex 32
JWT_SECRET=
SESSION_DAYS=30
COOKIE_SECURE=true
FE_URL=https://goodenglish.my.id

# "Tanya AI": the Gemini API key and model are set from Admin › Tanya AI and
# stored encrypted in the DB with this key (openssl rand -hex 32). Without it
# the app still runs, but no Gemini key can be saved.
ENCRYPTION_KEY=
# Default questions per day for NEW tokens (each token can then be changed,
# or made unlimited, from the admin token form). Resets at midnight WIB.
AI_DAILY_LIMIT=30
